# Flutter/Dart
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# Xcode/Android build noise once `flutter create .` has added ios/ and
# android/ (see CLAUDE.md, step 1) — the platform folders themselves are
# real project config and should be committed, not ignored.
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.podspec
android/.gradle/
android/local.properties

# macOS
.DS_Store
commit_stderr.log.stale

# fastlane — the API key descriptor and build outputs never get committed.
fastlane/api_key.json
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
fastlane/.review_information.parked/

# Local scratch
_to_delete/
.idea/
